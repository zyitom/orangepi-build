  AFTER  vi0: output => width: 1920, height: 1200, fmt: NV12|prs_in => x: 1920, y: 1200, hb: 478, hs: 1724|frame => cnt: 961, lost_cnt: 1, error_cnt: 0|
  dmesg: frame_lost=0 hblank=0 reset=0 not_mapped=0 oops=0 warn=0 | lines=8
