#!/bin/sh
# dpkg postinst: register modules, patch the device tree, enable the 3A daemon.
set -e
DTB=/boot/dtb/allwinner/sun60i-a733-orangepi-zero3w.dtb
VIND=/soc@3000000/vind@5800800


# device tree: AR0234 on MIPI-A through the ISP, unused MIPI-B sensor off
if [ ! -f "$DTB.orig-ar0234-camera" ]; then
	cp "$DTB" "$DTB.orig-ar0234-camera"
fi
fdtput -t s $DTB $VIND/sensor@5812000 sensor0_mname ar0234_mipi
fdtput -t i $DTB $VIND/sensor@5812000 sensor0_isp_used 1
fdtput -t s $DTB $VIND/sensor@5812020 status disabled

systemctl daemon-reload || true
systemctl enable ar0234-3ad.service || true

# new udev permissions for the video group (cedar_dev_ve2, g2d)
udevadm control --reload-rules || true

# keep apt from replacing the modules/dtb this package depends on
apt-mark hold linux-image-current-sun60iw2 linux-dtb-current-sun60iw2 || true

echo "ar0234-camera: installed, reboot to load the new device tree"
