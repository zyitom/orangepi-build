+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/i2c.h>
+#include <linux/delay.h>
+#include <linux/videodev2.h>
+#include <linux/clk.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-mediabus.h>
+#include <linux/io.h>
+
+#include "camera.h"
+#include "sensor_helper.h"
+
+MODULE_AUTHOR("Orange Pi");
+MODULE_DESCRIPTION("A low-level driver for AR0234 sensors");
+MODULE_LICENSE("GPL");
+
+#define MCLK              (24 * 1000 * 1000)
+#define V4L2_IDENT_SENSOR 0x0A56
+#define V4L2_IDENT_MONO   0x1A56
+
+/*
+ * The AR0234 sits on i2c with 7-bit ID 0x10 (0x20 in 8-bit form)
+ */
+#define I2C_ADDR 0x20
+#define SENSOR_NUM 0x2
+#define SENSOR_NAME "ar0234_mipi"
+#define SENSOR_NAME_2 "ar0234_mipi_2"
+
+/*
+ * Defaults for newly probed sensors; frame_rate can also be changed per
+ * sensor at runtime (V4L2_CID_FRAME_RATE, VIDIOC_VIN_SENSOR_SET_FPS,
+ * VIDIOC_S_PARM), trigger/flash are applied at the next stream start.
+ */
+static int frame_rate;
+module_param(frame_rate, int, 0644);
+MODULE_PARM_DESC(frame_rate, "default max frame rate in fps, 0 = native");
+
+static int trigger_mode;
+module_param(trigger_mode, int, 0644);
+MODULE_PARM_DESC(trigger_mode, "0 = free running, 1 = external trigger (pulsed/automatic), 2 = slave sync");
+
+static bool flash_enable;
+module_param(flash_enable, bool, 0644);
+MODULE_PARM_DESC(flash_enable, "drive the FLASH pin high during exposure");
+
+static int flash_delay;
+module_param(flash_delay, int, 0644);
+MODULE_PARM_DESC(flash_delay, "flash lead (<0) / lag (>0) in ~3.4us steps, -128..127");
+
+/* AR0234 registers (16-bit address, 16-bit data) */
+#define AR0234_REG_CHIP_ID             0x3000
+#define AR0234_REG_Y_ADDR_START        0x3002
+#define AR0234_REG_X_ADDR_START        0x3004
+#define AR0234_REG_Y_ADDR_END          0x3006
+#define AR0234_REG_X_ADDR_END          0x3008
+#define AR0234_REG_FRAME_LENGTH_LINES  0x300A
+#define AR0234_REG_EXPOSURE_COARSE     0x3012
+#define AR0234_REG_RESET               0x301A
+#define AR0234_REG_MODE_ORIENT         0x301C /* 8-bit pair: mode + orientation */
+#define AR0234_REG_GROUPED_HOLD        0x3022 /* 8-bit pair: hold + reserved */
+#define AR0234_REG_VT_PIX_CLK_DIV      0x302A
+#define AR0234_REG_VT_SYS_CLK_DIV      0x302C
+#define AR0234_REG_PRE_PLL_CLK_DIV     0x302E
+#define AR0234_REG_PLL_MULTIPLIER      0x3030
