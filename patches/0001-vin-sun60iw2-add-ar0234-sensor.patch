+#define AR0234_REG_TEMPSENS_CALIB1     0x30C6
+#define AR0234_REG_TEMPSENS_CALIB2     0x30C8
+#define AR0234_REG_GRR_CONTROL1        0x30CE
+#define AR0234_REG_AE_LUMA_TARGET      0x3102
+#define AR0234_REG_DELTA_DK_CONTROL    0x3180
+#define AR0234_REG_DATA_FORMAT_BITS    0x31AC
+#define AR0234_REG_SERIAL_FORMAT       0x31AE
+#define AR0234_REG_FRAME_PREAMBLE      0x31B0
+#define AR0234_REG_LINE_PREAMBLE       0x31B2
+#define AR0234_REG_MIPI_TIMING_0       0x31B4
+#define AR0234_REG_MIPI_TIMING_1       0x31B6
+#define AR0234_REG_MIPI_TIMING_2       0x31B8
+#define AR0234_REG_MIPI_TIMING_3       0x31BA
+#define AR0234_REG_MIPI_TIMING_4       0x31BC
+#define AR0234_REG_COMPANDING          0x31D0
+#define AR0234_REG_PIX_DEF_ID          0x31E0
+#define AR0234_REG_LED_FLASH_CONTROL   0x3270
+#define AR0234_REG_MIPI_CNTRL          0x3354
+
+/* 0x301A reset register */
+#define AR0234_RESET_DEFAULT      0x2058
+#define AR0234_RESET_STREAM       BIT(2)
+#define AR0234_RESET_GPI_EN       BIT(8)
+#define AR0234_RESET_FORCED_PLL_ON BIT(11)
+
+/* 0x30CE */
+#define AR0234_GRR_SLAVE_SH_SYNC  BIT(8)
+
+/* 0x3270 */
+#define AR0234_FLASH_ENABLE       BIT(8)
+
+/* sunxi private range, well above the ids sunxi_camera_v2.h uses (<= +23) */
+#define V4L2_CID_AR0234_TEMPERATURE    (V4L2_CID_USER_SUNXI_CAMERA_BASE + 0x70)
+
+#define AR0234_TRIGGER_MODE_OFF        0
+#define AR0234_TRIGGER_MODE_EXTERNAL   1
+#define AR0234_TRIGGER_MODE_SLAVE_SYNC 2
+
+/*
+ * 0x3060 analog gain: coarse s = bits[6:4], fine t = bits[3:0]
+ *   s = 0, 2: 2^s * 32 / (32 - t)
+ *   s = 1, 3: 2^s * 16 / (16 - t / 2)
+ *   s = 4:    2^s *  8 / ( 8 - t / 4)
+ * 0x0D (1.68x) is the recommended minimum, 0x40 (16x) the maximum.
+ */
+#define AR0234_ANA_GAIN_MIN_REG 0x0D
+#define AR0234_ANA_GAIN_MAX_REG 0x40
+
+/* 0x305E digital gain: 0x80 = 1.0x, linear, max 0x7FF */
+#define AR0234_DIG_GAIN_1X  0x0080
+#define AR0234_DIG_GAIN_MAX 0x07FF
+
+/* 0x30BA value right after reset (4-lane, 90MHz pixclk, gain < 0x20) */
+#define AR0234_MFR_30BA_DEFAULT 0x7622
+
+/* Exposure lower limit in lines */
+#define AR0234_EXPOSURE_MIN 2
+
+/* Lines the sensor adds to FRAME_LENGTH_LINES (measured: fps = pclk / (hts * (fll + 5))) */
+#define AR0234_FLL_OVERHEAD 5
+
+/*
+ * Analog gain lookup: index = register value - AR0234_ANA_GAIN_MIN_REG,
+ * value = sensor gain in 1/16 units, rounded.
+ */
+static const unsigned short ar0234_agc_table[] = {
+	27, 28, 30, 32, 32, 34, 34, 37, 37, 39,			/* 0x0D-0x16 */
+	39, 43, 43, 47, 47, 51, 51, 57, 57, 64,			/* 0x17-0x20 */
+	66, 68, 71, 73, 76, 79, 82, 85, 89, 93,			/* 0x21-0x2A */
+	98, 102, 108, 114, 120, 128, 128, 137, 137, 146,	/* 0x2B-0x34 */
+	146, 158, 158, 171, 171, 186, 186, 205, 205, 228,	/* 0x35-0x3E */
+	228, 256						/* 0x3F-0x40 */
+};
+
+static const char * const ar0234_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Color",
+	"Vertical Color Bars",
+	"Fade to Grey Color Bars",
+	"Walking 1s",
+};
+
+static const unsigned short ar0234_test_pattern_val[] = {
+	0, 1, 2, 3, 256,
+};
+
+struct ar0234 {
+	struct sensor_info info;	/* must stay first: freed via to_state() */
+	bool streaming;
+	bool mono;
+	unsigned short mfr_30ba;
+	int test_pattern;
+	int fps;		/* frame_rate control, 0 = native / S_PARM / module default */
+	int isp_fps;		/* libisp VIDIOC_VIN_SENSOR_SET_FPS, cleared at stream off */
+	unsigned int fll;	/* FRAME_LENGTH_LINES in use */
+};
+
+static inline struct ar0234 *to_ar0234(struct v4l2_subdev *sd)
+{
+	return container_of(to_state(sd), struct ar0234, info);
+}
