+/* write the high byte of an 8-bit register pair, keeping the low byte */
+static void ar0234_write_pair_hi(struct v4l2_subdev *sd, unsigned short reg,
+				 unsigned short hi)
+{
+	unsigned short val = 0;
+
+	sensor_read(sd, reg, &val);
+	sensor_write(sd, reg, (hi << 8) | (val & 0xff));
+}
+
+/*
+ * Write 0x301C/0x301D through one 16-bit access: high byte -> 0x301C
+ * (mode select: 1 = streaming), low byte -> 0x301D (bit0 hflip, bit1 vflip).
+ * The sensor shifts its readout on flip, so the Bayer order stays GRBG.
+ */
+static void ar0234_set_mode_orient(struct v4l2_subdev *sd, bool mode_select)
+{
+	struct sensor_info *info = to_state(sd);
+
+	sensor_write(sd, AR0234_REG_MODE_ORIENT,
+		     (mode_select << 8) | (info->vflip << 1) | info->hflip);
+}
+
+/* FRAME_LENGTH_LINES for the current window at the requested frame rate */
+static unsigned int ar0234_calc_fll(struct v4l2_subdev *sd)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+	struct sensor_info *info = &sensor->info;
+	struct sensor_win_size *ws = info->current_wins;
+	unsigned int fps = sensor->isp_fps ? sensor->isp_fps : sensor->fps, fll;
+
+	if (!ws)
+		return 0;
+	if (!fps && info->tpf.numerator && info->tpf.denominator)
+		fps = info->tpf.denominator / info->tpf.numerator;
+	if (!fps)
+		fps = frame_rate;
+	if (!fps)
+		return ws->vts;
+
+	fll = ws->pclk / (ws->hts * fps);
+	fll = fll > AR0234_FLL_OVERHEAD ? fll - AR0234_FLL_OVERHEAD : 0;
+	if (fll < ws->vts)
+		fll = ws->vts;
+	if (fll > 0xffff)
+		fll = 0xffff;
+	return fll;
+}
+
+/* true when an application asked for a frame rate that exposure must not break */
+static bool ar0234_fps_requested(struct v4l2_subdev *sd)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+
+	return sensor->isp_fps || sensor->fps || frame_rate ||
+	       (sensor->info.tpf.numerator && sensor->info.tpf.denominator);
+}
+
+static unsigned int ar0234_fll_to_fps(struct sensor_win_size *ws, unsigned int fll)
+{
+	return ws->pclk / (ws->hts * (fll + AR0234_FLL_OVERHEAD));
+}
+
+/*
+ * Exposure in lines. With a requested frame rate the exposure is capped to
+ * the frame length (AE then raises gain), otherwise a long exposure
+ * stretches the frame.
+ */
+static unsigned short ar0234_exp_lines(struct v4l2_subdev *sd, unsigned int exp_val)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+	unsigned int shutter = exp_val >> 4;
+
+	if (ar0234_fps_requested(sd) && sensor->fll > 4 && shutter > sensor->fll - 4)
+		shutter = sensor->fll - 4;
+	if (shutter < AR0234_EXPOSURE_MIN)
+		shutter = AR0234_EXPOSURE_MIN;
+	if (shutter > 0xffff)
+		shutter = 0xffff;
+	return shutter;
+}
+
+static void ar0234_apply_fll(struct v4l2_subdev *sd)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+	unsigned int fll = ar0234_calc_fll(sd);
+
+	if (!fll)
+		return;
+	sensor->fll = fll;
+	if (sensor->streaming) {
+		unsigned int shutter = ar0234_exp_lines(sd, sensor->info.exp);
+
+		if (!sensor->info.exp) {
+			/* nothing set yet: keep the sensor's default exposure */
+			sensor_write(sd, AR0234_REG_FRAME_LENGTH_LINES, fll);
+			return;
+		}
+		sensor_write(sd, AR0234_REG_FRAME_LENGTH_LINES, max(fll, shutter + 4U));
+		sensor_write(sd, AR0234_REG_EXPOSURE_COARSE, shutter);
+	}
+}
+
+static void ar0234_write_gain(struct v4l2_subdev *sd, int gain_val)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+	unsigned short ana_reg = AR0234_ANA_GAIN_MIN_REG;
+	unsigned short ana_gain, mfr_30ba;
+	unsigned int dig_gain;
+	int i;
+
+	/* largest register value with analog gain <= requested gain */
+	for (i = AR0234_ANA_GAIN_MIN_REG; i <= AR0234_ANA_GAIN_MAX_REG; i++) {
+		if (ar0234_agc_table[i - AR0234_ANA_GAIN_MIN_REG] > gain_val)
+			break;
+		ana_reg = i;
+	}
+	ana_gain = ar0234_agc_table[ana_reg - AR0234_ANA_GAIN_MIN_REG];
+
+	/*
+	 * remainder as digital gain, 0x80 = 1.0x. Requests below the 1.68x
+	 * analog minimum clamp to 1.0x digital, i.e. the image is brighter.
+	 */
+	dig_gain = (unsigned int)gain_val * 128 / ana_gain;
+	dig_gain = clamp_t(unsigned int, dig_gain, AR0234_DIG_GAIN_1X, AR0234_DIG_GAIN_MAX);
+
+	/*
+	 * 0x30BA mfr bits depend on pixclk (90MHz for 4-lane) and analog
+	 * gain level, per the Kurokesu/RPi driver.
+	 */
+	if (ana_reg < 0x20)
+		mfr_30ba = 0x7622;
+	else if (ana_reg < 0x3A)
+		mfr_30ba = 0x7621;
+	else
+		mfr_30ba = 0x7620;
+
+	if (mfr_30ba != sensor->mfr_30ba) {
+		sensor_write(sd, AR0234_REG_MFR_30BA, mfr_30ba);
+		sensor->mfr_30ba = mfr_30ba;
+	}
+
+	sensor_write(sd, AR0234_REG_ANALOG_GAIN, ana_reg);
+	sensor_write(sd, AR0234_REG_DIGITAL_GAIN, dig_gain);
+}
+
+static int sensor_s_exp(struct v4l2_subdev *sd, unsigned int exp_val)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+
+	if (exp_val > 0xfffff)
+		exp_val = 0xfffff;
+	sensor->info.exp = exp_val;
+	/* registers are lost on the soft reset at stream on, see sensor_reg_init */
+	if (!sensor->streaming)
+		return 0;
+
+	sensor_write(sd, AR0234_REG_EXPOSURE_COARSE, ar0234_exp_lines(sd, exp_val));
+	return 0;
+}
+
+static int sensor_s_gain(struct v4l2_subdev *sd, int gain_val)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+
+	gain_val = clamp(gain_val, 1 * 16, 256 * 16);
+	sensor->info.gain = gain_val;
+	if (!sensor->streaming)
+		return 0;
+
+	ar0234_write_gain(sd, gain_val);
+	return 0;
+}
+
+/*
+ * ISP AE entry point: frame length, exposure and gain land on the same
+ * frame thanks to the grouped parameter hold.
+ */
+static int sensor_s_exp_gain(struct v4l2_subdev *sd,
+			     struct sensor_exp_gain *exp_gain)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+	struct sensor_info *info = &sensor->info;
+	unsigned int exp_val, shutter;
+	int gain_val;
+
+	exp_val = min_t(unsigned int, exp_gain->exp_val, 0xfffff);
+	gain_val = clamp(exp_gain->gain_val, 1 * 16, 256 * 16 - 1);
+	info->exp = exp_val;
+	info->gain = gain_val;
+	if (!sensor->streaming)
+		return 0;
+
+	shutter = ar0234_exp_lines(sd, exp_val);
+	ar0234_write_pair_hi(sd, AR0234_REG_GROUPED_HOLD, 1);
+	sensor_write(sd, AR0234_REG_FRAME_LENGTH_LINES,
+		     max(sensor->fll, shutter + 4));
+	sensor_write(sd, AR0234_REG_EXPOSURE_COARSE, shutter);
+	ar0234_write_gain(sd, gain_val);
+	ar0234_write_pair_hi(sd, AR0234_REG_GROUPED_HOLD, 0);
+	return 0;
+}
+
+static int sensor_g_exp(struct v4l2_subdev *sd, __s32 *value)
+{
+	struct sensor_info *info = to_state(sd);
+
+	*value = info->exp;
+	sensor_dbg("sensor_get_exposure = %d\n", info->exp);
+	return 0;
+}
+
+static int sensor_g_gain(struct v4l2_subdev *sd, __s32 *value)
+{
+	struct sensor_info *info = to_state(sd);
+
+	*value = info->gain;
+	sensor_dbg("sensor_get_gain = %d\n", info->gain);
+	return 0;
+}
+
+/*
+ * On-die temperature sensor, powered and converting since init
+ * (TEMPSENS_CTRL = 0x0011). Approximate: uses the 0.7 degC/LSB slope and
+ * 55 degC calibration point of the Aptina AR01xx family, AR0234 datasheet
+ * values are not public.
+ */
+static int ar0234_get_temp(struct v4l2_subdev *sd, int *temp)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+	unsigned short data = 0, calib = 0;
+
+	if (!sensor->streaming)
+		return -EBUSY;
+
+	sensor_read(sd, AR0234_REG_TEMPSENS_DATA, &data);
+	sensor_read(sd, AR0234_REG_TEMPSENS_CALIB2, &calib);
+	if (!calib)
+		sensor_read(sd, AR0234_REG_TEMPSENS_CALIB1, &calib);
+	if (!calib)
+		return -ENODATA;
+
+	*temp = 55 + ((int)(data & 0x7ff) - (int)calib) * 7 / 10;
+	return 0;
+}
+
+/*
+ * Stuff that knows about the sensor.
+ */
+
+static int sensor_power(struct v4l2_subdev *sd, int on)
+{
+	switch (on) {
+	case STBY_ON:
+		sensor_dbg("STBY_ON!\n");
+		cci_lock(sd);
+		vin_gpio_write(sd, RESET, CSI_GPIO_LOW);
+		cci_unlock(sd);
+		vin_set_mclk(sd, OFF);
+		break;
+	case STBY_OFF:
+		sensor_dbg("STBY_OFF!\n");
+		cci_lock(sd);
+		vin_set_mclk_freq(sd, MCLK);
+		vin_set_mclk(sd, ON);
+		msleep(20);
+		cci_unlock(sd);
+		vin_gpio_write(sd, RESET, CSI_GPIO_HIGH);
+		break;
+	case PWR_ON:
+		sensor_dbg("PWR_ON!\n");
+		cci_lock(sd);
+		vin_gpio_set_status(sd, PWDN, 1);
+		vin_gpio_set_status(sd, RESET, 1);
+		vin_gpio_write(sd, PWDN, CSI_GPIO_LOW);
+		vin_gpio_write(sd, RESET, CSI_GPIO_LOW);
+		usleep_range(1000, 1200);
+		vin_set_mclk_freq(sd, MCLK);
+		vin_set_mclk(sd, ON);
+		usleep_range(10000, 12000);
+		vin_gpio_write(sd, POWER_EN, CSI_GPIO_HIGH);
+		vin_set_pmu_channel(sd, IOVDD, ON);
+		vin_set_pmu_channel(sd, AVDD, ON);
+		vin_set_pmu_channel(sd, DVDD, ON);
+		usleep_range(10000, 12000);
+		vin_gpio_write(sd, PWDN, CSI_GPIO_HIGH);
+		vin_gpio_write(sd, RESET, CSI_GPIO_HIGH);
+		usleep_range(30000, 31000);
+		cci_unlock(sd);
+		break;
+	case PWR_OFF:
+		sensor_dbg("PWR_OFF!\n");
+		cci_lock(sd);
+		vin_set_mclk(sd, OFF);
+		vin_gpio_write(sd, POWER_EN, CSI_GPIO_LOW);
+		vin_set_pmu_channel(sd, DVDD, OFF);
+		vin_set_pmu_channel(sd, AVDD, OFF);
+		vin_set_pmu_channel(sd, IOVDD, OFF);
+		usleep_range(10000, 12000);
+		vin_gpio_write(sd, PWDN, CSI_GPIO_LOW);
+		vin_gpio_write(sd, RESET, CSI_GPIO_LOW);
+
+		vin_gpio_set_status(sd, RESET, 0);
+		vin_gpio_set_status(sd, PWDN, 0);
+		cci_unlock(sd);
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static int sensor_reset(struct v4l2_subdev *sd, u32 val)
+{
+	switch (val) {
+	case 0:
+		vin_gpio_write(sd, RESET, CSI_GPIO_HIGH);
+		usleep_range(10000, 12000);
+		break;
+	case 1:
+		vin_gpio_write(sd, RESET, CSI_GPIO_LOW);
+		usleep_range(10000, 12000);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int sensor_detect(struct v4l2_subdev *sd)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+	unsigned short rdval = 0;
+	int cnt = 0;
+
+	sensor_read(sd, AR0234_REG_CHIP_ID, &rdval);
+	sensor_print("V4L2_IDENT_SENSOR = 0x%x\n", rdval);
+
+	while ((rdval != V4L2_IDENT_SENSOR) && (rdval != V4L2_IDENT_MONO) &&
+	       (cnt < 5)) {
+		sensor_read(sd, AR0234_REG_CHIP_ID, &rdval);
+		sensor_print("retry = %d, V4L2_IDENT_SENSOR = %x\n", cnt, rdval);
+		cnt++;
+	}
+
+	if ((rdval != V4L2_IDENT_SENSOR) && (rdval != V4L2_IDENT_MONO))
+		return -ENODEV;
+
+	sensor->mono = rdval == V4L2_IDENT_MONO;
+	/*
+	 * sunxi-vin has no Y10 capture format: the monochrome part is still
+	 * exposed as SGRBG10, every pixel carries luminance.
+	 */
+	sensor_print("find the onsemi AR0234%s ***********\n",
+		     sensor->mono ? " (monochrome)" : "");
+	return 0;
+}
+
+static int sensor_init(struct v4l2_subdev *sd, u32 val)
+{
+	int ret;
+	struct sensor_info *info = to_state(sd);
+
+	sensor_dbg("sensor_init\n");
+
+	/* Make sure it is a target sensor */
+	ret = sensor_detect(sd);
+	if (ret) {
+		sensor_err("chip found is not an target chip.\n");
+		return ret;
+	}
+
+	info->focus_status = 0;
+	info->low_speed = 0;
+	info->width = 1920;
+	info->height = 1200;
+	/* hflip/vflip keep the value of their V4L2 controls across opens */
+
+	/*
+	 * No frame rate requested until VIDIOC_S_PARM: a real value here
+	 * would make sensor_find_frame_size() prefer windows by fps.
+	 */
+	info->tpf.numerator = 1;
+	info->tpf.denominator = 0;
+
+	info->preview_first_flag = 1;
+
+	return 0;
+}
+
+static long sensor_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+	struct sensor_info *info = &sensor->info;
+	struct sensor_win_size *ws = info->current_wins;
+	int ret = 0;
+
+	switch (cmd) {
+	case GET_CURRENT_WIN_CFG:
+		if (ws != NULL) {
+			struct sensor_win_size *out = arg;
+			unsigned int fll = ar0234_calc_fll(sd);
+
+			memcpy(out, ws, sizeof(*ws));
+			/* report the frame rate and exposure range really in use */
+			out->vts = fll;
+			out->fps_fixed = ar0234_fll_to_fps(ws, fll);
+			out->intg_max = (fll - 4) << 4;
+			ret = 0;
+		} else {
+			sensor_err("empty wins!\n");
+			ret = -1;
+		}
+		break;
+	case SET_FPS:
+		break;
+	case VIDIOC_VIN_SENSOR_EXP_GAIN:
+		sensor_s_exp_gain(sd, (struct sensor_exp_gain *)arg);
+		break;
+	case VIDIOC_VIN_SENSOR_SET_FPS:
+		/*
+		 * libisp (ispSetFpsRanage) sets the rate of its own stream only;
+		 * keeping it would override the next stream's VIDIOC_S_PARM.
+		 */
+		sensor->isp_fps = max(((struct sensor_fps *)arg)->fps, 0);
+		ar0234_apply_fll(sd);
+		break;
+#ifdef VIDIOC_VIN_SENSOR_GET_FPS
+	case VIDIOC_VIN_SENSOR_GET_FPS:
+		if (!ws)
+			return -EINVAL;
+		((struct sensor_fps *)arg)->fps =
+			ar0234_fll_to_fps(ws, ar0234_calc_fll(sd));
+		break;
+#endif
+	case VIDIOC_VIN_SENSOR_GET_TEMP:
+		ret = ar0234_get_temp(sd, &((struct sensor_temp *)arg)->temp);
+		break;
+	case VIDIOC_VIN_SENSOR_GET_FLIP:
+		((struct sensor_flip *)arg)->hflip = info->hflip;
+		((struct sensor_flip *)arg)->vflip = info->vflip;
+		break;
+	case VIDIOC_VIN_SENSOR_CFG_REQ:
+		sensor_cfg_req(sd, (struct sensor_config *)arg);
+		if (ws) {
+			struct sensor_config *cfg = arg;
+			unsigned int fll = ar0234_calc_fll(sd);
+
+			/* libisp AE plans with these: report what is really in use */
+			cfg->vts = fll;
+			cfg->fps_fixed = ar0234_fll_to_fps(ws, fll);
+			cfg->intg_max = (fll - 4) << 4;
+		}
+		break;
+	default:
+		return -EINVAL;
+	}
+	return ret;
+}
+
