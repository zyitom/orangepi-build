+
+static void ar0234_start_stream(struct v4l2_subdev *sd)
+{
+	int tm = trigger_mode;
+
+	if (flash_enable)
+		sensor_write(sd, AR0234_REG_LED_FLASH_CONTROL,
+			     AR0234_FLASH_ENABLE |
+			     (u8)clamp(flash_delay, -128, 127));
+
+	if (tm == AR0234_TRIGGER_MODE_OFF) {
+		ar0234_set_mode_orient(sd, true);
+		return;
+	}
+
+	/* orientation only: the TRIGGER pin starts each exposure */
+	ar0234_set_mode_orient(sd, false);
+	if (tm == AR0234_TRIGGER_MODE_SLAVE_SYNC) {
+		sensor_write(sd, AR0234_REG_GRR_CONTROL1, AR0234_GRR_SLAVE_SH_SYNC);
+		sensor_write(sd, AR0234_REG_RESET,
+			     AR0234_RESET_DEFAULT | AR0234_RESET_GPI_EN |
+			     AR0234_RESET_FORCED_PLL_ON | AR0234_RESET_STREAM);
+	} else {
+		sensor_write(sd, AR0234_REG_RESET,
+			     AR0234_RESET_DEFAULT | AR0234_RESET_GPI_EN |
+			     AR0234_RESET_FORCED_PLL_ON);
+	}
+	sensor_print("trigger mode %d, flash %d\n", tm, flash_enable);
+}
+
+static int sensor_reg_init(struct sensor_info *info)
+{
+	int ret = 0;
+	struct v4l2_subdev *sd = &info->sd;
+	struct ar0234 *sensor = to_ar0234(sd);
+	struct sensor_format_struct *sensor_fmt = info->fmt;
+	struct sensor_win_size *wsize = info->current_wins;
+
+	ret = sensor_write_array(sd, sensor_default_regs,
+				 ARRAY_SIZE(sensor_default_regs));
+	if (ret < 0) {
+		sensor_err("write sensor_default_regs error\n");
+		return ret;
+	}
+
+	sensor_write_array(sd, sensor_fmt->regs, sensor_fmt->regs_size);
+
+	if (wsize->regs)
+		sensor_write_array(sd, wsize->regs, wsize->regs_size);
+
+	if (wsize->set_size)
+		wsize->set_size(sd);
+
+	info->width = wsize->width;
+	info->height = wsize->height;
+
+	/*
+	 * The soft reset above dropped every sensor register: resync the
+	 * 0x30BA cache and re-apply controls set before streaming.
+	 */
+	sensor->mfr_30ba = AR0234_MFR_30BA_DEFAULT;
+	sensor->streaming = true;
+	ar0234_apply_fll(sd);
+	if (info->exp)
+		sensor_s_exp(sd, info->exp);
+	if (info->gain)
+		sensor_s_gain(sd, info->gain);
+	if (sensor->test_pattern)
+		sensor_write(sd, AR0234_REG_TEST_PATTERN_MODE,
+			     ar0234_test_pattern_val[sensor->test_pattern]);
+
+	ar0234_start_stream(sd);
+
+	sensor_print("s_fmt set width = %d, height = %d, fll = %d (%d fps)\n",
+		     wsize->width, wsize->height, sensor->fll,
+		     ar0234_fll_to_fps(wsize, sensor->fll));
+
+	return 0;
+}
+
+static int sensor_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct ar0234 *sensor = to_ar0234(sd);
+	struct sensor_info *info = &sensor->info;
+
+	sensor_print("%s on = %d, %d*%d %x\n", __func__, enable,
+		     info->current_wins->width,
+		     info->current_wins->height, info->fmt->mbus_code);
+
+	if (!enable) {
+		/* standby: streaming, trigger input and forced PLL off */
+		sensor_write(sd, AR0234_REG_RESET, AR0234_RESET_DEFAULT);
+		ar0234_set_mode_orient(sd, false);
+		sensor->streaming = false;
+		sensor->isp_fps = 0;
+		return 0;
+	}
+	return sensor_reg_init(info);
+}
+
+/*
+ * sensor_find_frame_size() prefers windows whose fps_fixed equals the
+ * VIDIOC_S_PARM rate, so 1280x720 @ 120fps picked the 1920x1200 (120fps)
+ * window and made the scaler downsize it. Every window can run slower via
+ * FRAME_LENGTH_LINES, so always choose by resolution.
+ */
+static int ar0234_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct sensor_info *info = to_state(sd);
+	__u32 den = info->tpf.denominator;
+	int ret;
+
+	info->tpf.denominator = 0;
+	ret = sensor_set_fmt(sd, state, fmt);
+	info->tpf.denominator = den;
+	return ret;
+}
+
+static int sensor_g_mbus_config(struct v4l2_subdev *sd, unsigned int pad,
+				struct v4l2_mbus_config *cfg)
+{
+	cfg->type = V4L2_MBUS_CSI2_DPHY;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+	cfg->bus.mipi_csi2.num_data_lanes = 0 | V4L2_MBUS_CSI2_4_LANE |
+					    V4L2_MBUS_CSI2_CHANNEL_0;
+#else
+	cfg->flags = 0 | V4L2_MBUS_CSI2_4_LANE | V4L2_MBUS_CSI2_CHANNEL_0;
+#endif
+
+	return 0;
+}
+
+static int sensor_g_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sensor_info *info =
+			container_of(ctrl->handler, struct sensor_info, handler);
+	struct v4l2_subdev *sd = &info->sd;
+
+	switch (ctrl->id) {
+	case V4L2_CID_GAIN:
+		/* info->gain is 1/16 (libisp AE writes it too), the control 1/1600 */
+		sensor_g_gain(sd, &ctrl->val);
+		ctrl->val = clamp(ctrl->val * 100, ctrl->minimum, ctrl->maximum);
+		return 0;
+	case V4L2_CID_EXPOSURE:
+		return sensor_g_exp(sd, &ctrl->val);
+	case V4L2_CID_AR0234_TEMPERATURE:
+		if (ar0234_get_temp(sd, &ctrl->val))
+			ctrl->val = 0;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int sensor_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sensor_info *info =
+			container_of(ctrl->handler, struct sensor_info, handler);
+	struct v4l2_subdev *sd = &info->sd;
+	struct ar0234 *sensor = to_ar0234(sd);
+
+	switch (ctrl->id) {
+	case V4L2_CID_GAIN:
+		/* BSP gain ctrl unit is 1/1600, sensor_s_gain takes 1/16 */
+		return sensor_s_gain(sd, ctrl->val / 100);
+	case V4L2_CID_EXPOSURE:
+		return sensor_s_exp(sd, ctrl->val);
+	case V4L2_CID_HFLIP:
+		info->hflip = ctrl->val;
+		ar0234_set_mode_orient(sd, sensor->streaming &&
+				       trigger_mode == AR0234_TRIGGER_MODE_OFF);
+		return 0;
+	case V4L2_CID_VFLIP:
+		info->vflip = ctrl->val;
+		ar0234_set_mode_orient(sd, sensor->streaming &&
+				       trigger_mode == AR0234_TRIGGER_MODE_OFF);
+		return 0;
+	case V4L2_CID_TEST_PATTERN:
+		sensor->test_pattern = ctrl->val;
+		if (sensor->streaming)
+			sensor_write(sd, AR0234_REG_TEST_PATTERN_MODE,
+				     ar0234_test_pattern_val[ctrl->val]);
+		return 0;
+	case V4L2_CID_FRAME_RATE:
+		sensor->fps = ctrl->val;
+		ar0234_apply_fll(sd);
+		return 0;
+	}
+	return -EINVAL;
+}
