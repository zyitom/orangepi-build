# PREEMPT_RT fixup for the Rockchip RKNPU vendor driver (found by rt_scan_rk3588.py).
#
# drivers/rknpu hrtimer_handler() runs in hardirq context on PREEMPT_RT and took
# spin_lock_irqsave(&rknpu_dev->irq_lock) -- on RT spinlock_t is a sleeping lock,
# so every RKNPU_LOAD_INTERVAL tick would hit "BUG: sleeping function called from
# invalid context" once the NPU driver probes.
#
# Convert rknpu_dev->irq_lock to raw_spinlock_t: every critical section only does
# ktime math, list ops and MMIO register access (no sleeping calls), so the raw
# conversion is safe and keeps the NPU working under RT. Same treatment the
# upstream RT series applies to vendor drivers.
#
# Applies on top of 0000-rt36-rk35xx.patch (does not depend on it).
diff --git a/drivers/rknpu/include/rknpu_drv.h b/drivers/rknpu/include/rknpu_drv.h
index 3f3804ad7..04cb3aeb2 100644
--- a/drivers/rknpu/include/rknpu_drv.h
+++ b/drivers/rknpu/include/rknpu_drv.h
@@ -122,7 +122,7 @@ struct rknpu_device {
 #endif
 	atomic_t sequence;
 	spinlock_t lock;
-	spinlock_t irq_lock;
+	raw_spinlock_t irq_lock;
 	struct mutex power_lock;
 	struct mutex reset_lock;
 	struct mutex domain_lock;
diff --git a/drivers/rknpu/rknpu_debugger.c b/drivers/rknpu/rknpu_debugger.c
index b3caca81b..e1eaa998f 100644
--- a/drivers/rknpu/rknpu_debugger.c
+++ b/drivers/rknpu/rknpu_debugger.c
@@ -55,11 +55,11 @@ static int rknpu_load_show(struct seq_file *m, void *data)
 		if (rknpu_dev->config->num_irqs > 1)
 			seq_printf(m, " Core%d: ", i);
 
-		spin_lock_irqsave(&rknpu_dev->irq_lock, flags);
+		raw_spin_lock_irqsave(&rknpu_dev->irq_lock, flags);
 
 		total_busy_time = subcore_data->timer.total_busy_time;
 
-		spin_unlock_irqrestore(&rknpu_dev->irq_lock, flags);
+		raw_spin_unlock_irqrestore(&rknpu_dev->irq_lock, flags);
 
 		div_value = (RKNPU_LOAD_INTERVAL / 100);
 		do_div(total_busy_time, div_value);
