+static int __vin_s_input(struct vin_core *vinc, unsigned int i);
+
+/*
+ * Generic V4L2 applications (v4l2-ctl, GStreamer v4l2src, OpenCV) never call
+ * VIDIOC_S_INPUT, which is what powers the sensor and links the pipeline.
+ * Select input 0 on their behalf the first time it is needed.
+ */
+static int vin_auto_s_input(struct vin_core *vinc)
+{
+	struct v4l2_subdev *sensor = vinc->vid_cap.pipe.sd[VIN_IND_SENSOR];
+
+	if (sensor && sensor->entity.use_count)
+		return 0;
+
+	vin_log(VIN_LOG_VIDEO, "video%d: no S_INPUT yet, selecting input 0\n", vinc->id);
+	return __vin_s_input(vinc, 0);
+}
